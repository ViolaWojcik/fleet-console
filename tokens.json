{
  "_meta": {
    "exportedAt": "2026-09-27T17:24:51.000Z",
    "figmaFile": "MZInnUxno6SY95v9W7D4ap",
    "source": "Figma variables read through the Plugin API (use_figma), aliases resolved per mode; never edit by hand, re-export instead",
    "nameChain": "Figma variable -> CSS custom property (codeSyntax.WEB) -> Tailwind 4 @theme (see theme.css)",
    "decision": "Monochrome by decision (27.09.2026): one red on severity/stop, two modes light (default) / dark (after the site's local sunset) from the same 24 colour tokens"
  },
  "color": {
    "modes": ["light", "dark"],
    "defaultMode": "light",
    "variables": {
      "surface/inset":     { "light": "#D5D9DE", "dark": "#0F1012", "css": "var(--color-surface-inset)",     "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
      "surface/base":      { "light": "#E6E8EB", "dark": "#17181B", "css": "var(--color-surface-base)",      "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
      "surface/raised":    { "light": "#FFFFFF", "dark": "#202226", "css": "var(--color-surface-raised)",    "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
      "surface/overlay":   { "light": "#F3F4F6", "dark": "#2A2D32", "css": "var(--color-surface-overlay)",   "scopes": ["FRAME_FILL", "SHAPE_FILL"] },
      "text/primary":      { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-text-primary)",      "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "text/secondary":    { "light": "#4A4D52", "dark": "#B3B4B0", "css": "var(--color-text-secondary)",    "scopes": ["TEXT_FILL"] },
      "text/muted":        { "light": "#5A5E64", "dark": "#9A9DA2", "css": "var(--color-text-muted)",        "scopes": ["TEXT_FILL"], "description": "Tertiary ink for counts, separators and helper text inside raised, base and overlay. Never straight on surface/metal: at the dark end of the gradient it is 4.6 : 1, so text on the metal uses text/secondary." },
      "border/hair":       { "light": "#D7DADF", "dark": "#33363B", "css": "var(--color-border-hair)",       "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"] },
      "border/strong":     { "light": "#7A7E84", "dark": "#7F8288", "css": "var(--color-border-strong)",     "scopes": ["STROKE_COLOR"] },
      "border/focus":      { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-border-focus)",      "scopes": ["TEXT_FILL", "STROKE_COLOR"] },
      "link":              { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-link)",              "alias": "border/focus", "scopes": ["TEXT_FILL", "STROKE_COLOR"], "description": "Alias of border/focus. The console has no brand accent and no interaction hue: links are text/primary with a hairline underline; focus is a 2 px ring in the same ink." },
      "severity/clear":    { "light": "#5A5E64", "dark": "#9A9DA2", "css": "var(--color-severity-clear)",    "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "severity/watch":    { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-severity-watch)",    "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "severity/act":      { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-severity-act)",      "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "severity/stop":     { "light": "#B3261E", "dark": "#FF5A4F", "css": "var(--color-severity-stop)",     "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "severity/stop-ink": { "light": "#FFFFFF", "dark": "#111111", "css": "var(--color-severity-stop-ink)", "scopes": ["TEXT_FILL"], "description": "Text on the STOP block: white on paper, black at night. The only place where text sits on the red." },
      "evidence/lowers":   { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-evidence-lowers)",   "alias": "severity/watch", "scopes": ["TEXT_FILL", "STROKE_COLOR"], "description": "Alias of severity/watch. Colour of the \"what lowered the confidence\" list." },
      "signal/missing":    { "light": "#5A5E64", "dark": "#9A9DA2", "css": "var(--color-signal-missing)",    "scopes": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR"] },
      "signal/stale":      { "light": "#4A4D52", "dark": "#B3B4B0", "css": "var(--color-signal-stale)",      "scopes": ["ALL_FILLS", "STROKE_COLOR"] },
      "signal/suspect":    { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-signal-suspect)",    "scopes": ["ALL_FILLS", "STROKE_COLOR"] },
      "series/1":          { "light": "#111111", "dark": "#F2F2F0", "css": "var(--color-series-1)",          "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"], "lineStyle": "solid", "marker": "square" },
      "series/2":          { "light": "#4A4D52", "dark": "#B3B4B0", "css": "var(--color-series-2)",          "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"], "lineStyle": "dashed 5 3", "marker": "ring" },
      "series/3":          { "light": "#7E8288", "dark": "#9A9DA2", "css": "var(--color-series-3)",          "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"], "lineStyle": "dotted 1 3", "marker": "triangle" },
      "series/reference":  { "light": "#7A7E84", "dark": "#7F8288", "css": "var(--color-series-reference)",  "scopes": ["FRAME_FILL", "SHAPE_FILL", "STROKE_COLOR"], "lineStyle": "dashed 4 4" }
    }
  },
  "paintStyles": {
    "surface/metal · light": { "type": "linear-gradient", "stops": [["0%", "#F2F3F5"], ["55%", "#E3E6EA"], ["100%", "#D5D9DE"]], "description": "Brushed-steel page background, decorative. Content sits on raised, base and overlay; the only text read straight against it (legends and notes under the console) uses text/secondary, never text/muted (rule 6)." },
    "surface/metal · dark":  { "type": "linear-gradient", "stops": [["0%", "#1F2125"], ["55%", "#17181B"], ["100%", "#0F1012"]], "description": "Brushed-steel page background, decorative. Content sits on raised, base and overlay; the only text read straight against it (legends and notes under the console) uses text/secondary, never text/muted (rule 6)." }
  },
  "density": {
    "modes": ["default", "compact", "comfortable"],
    "defaultMode": "default",
    "variables": {
      "row-h":     { "default": 40, "compact": 32, "comfortable": 48, "css": "var(--density-row-h)",     "scopes": ["WIDTH_HEIGHT"] },
      "cell-px":   { "default": 10, "compact": 8,  "comfortable": 12, "css": "var(--density-cell-px)",   "scopes": ["GAP"] },
      "cell-py":   { "default": 9,  "compact": 6,  "comfortable": 12, "css": "var(--density-cell-py)",   "scopes": ["GAP"] },
      "data-size": { "default": 13, "compact": 12, "comfortable": 13, "css": "var(--density-data-size)", "scopes": ["FONT_SIZE"] },
      "gap":       { "default": 8,  "compact": 6,  "comfortable": 10, "css": "var(--density-gap)",       "scopes": ["GAP"] }
    }
  },
  "layout": {
    "modes": ["desktop 1440", "laptop 1280"],
    "defaultMode": "desktop 1440",
    "note": "Breakpoints as variable modes (added 27.09 evening for the Fleet / lanes / 1280 screen). The lane strip is FILL: it takes what the four columns leave, and every mark inside scales with it (SCALE constraints), so a −21 d tick stays at −21 d at any width.",
    "variables": {
      "lane/col-turbine":    { "desktop 1440": 88,   "laptop 1280": 72,  "css": "var(--layout-lane-col-turbine)",    "scopes": ["WIDTH_HEIGHT"] },
      "lane/col-severity":   { "desktop 1440": 88,   "laptop 1280": 80,  "css": "var(--layout-lane-col-severity)",   "scopes": ["WIDTH_HEIGHT"] },
      "lane/col-confidence": { "desktop 1440": 164,  "laptop 1280": 148, "css": "var(--layout-lane-col-confidence)", "scopes": ["WIDTH_HEIGHT"] },
      "lane/col-since":      { "desktop 1440": 48,   "laptop 1280": 48,  "css": "var(--layout-lane-col-since)",      "scopes": ["WIDTH_HEIGHT"] },
      "lane/col-median":     { "desktop 1440": 88,   "laptop 1280": 80,  "css": "var(--layout-lane-col-median)",     "scopes": ["WIDTH_HEIGHT"], "note": "the counted median warning as \"in 15 d\" / \"10 d late\", italic mono; the strip carries events only, no projection band (decision 27.09 night)" },
      "console/width":       { "desktop 1440": 1120, "laptop 1280": 960, "css": "var(--layout-console-width)",       "scopes": ["WIDTH_HEIGHT"] }
    }
  },
  "space": {
    "modes": ["value"],
    "variables": { "2": 2, "4": 4, "6": 6, "8": 8, "10": 10, "12": 12, "16": 16, "20": 20, "24": 24, "32": 32, "40": 40, "48": 48, "64": 64 },
    "css": "var(--space-<n>)",
    "scopes": ["WIDTH_HEIGHT", "GAP"]
  },
  "radius": {
    "modes": ["value"],
    "variables": { "sm": 2, "md": 4, "lg": 6, "xl": 8, "full": 999 },
    "css": "var(--radius-<name>)",
    "use": { "full": "pills: Button, QueryBar, segmented controls", "md": "fields: Input", "lg": "doc cards", "xl": "floating glass panels: DisagreeForm, ShiftHandover, service order" }
  },
  "type": {
    "modes": ["value"],
    "variables": {
      "font/display": { "value": "Fraunces",      "css": "var(--font-display)",    "use": "headings, the big confidence number, sentences the model or a person says; never in a table cell" },
      "font/sans":    { "value": "Inter",         "css": "var(--type-font-sans)",  "use": "UI" },
      "font/mono":    { "value": "IBM Plex Mono", "css": "var(--type-font-mono)",  "use": "every number and identifier" },
      "size/micro": 10, "size/caption": 11, "size/body-sm": 12, "size/data-sm": 12, "size/body": 13, "size/data": 13,
      "size/body-lg": 14, "size/heading-sm": 15, "size/heading": 18, "size/display": 26
    },
    "css": "var(--type-size-<name>)"
  },
  "motion": {
    "modes": ["value"],
    "variables": {
      "state": { "value": 0.12, "css": "var(--motion-state)", "description": "Hover, focus, selection: 120 ms ease-out." },
      "panel": { "value": 0.20, "css": "var(--motion-panel)", "description": "Panel slide-in: 200 ms ease-out. Data changes are never animated." }
    }
  }
}
